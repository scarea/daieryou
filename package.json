{
  "name": "daieryou-royale",
  "version": "1.2.0",
  "private": true,
  "description": "金殿棋牌 —— 红中麻将、逮二游等好友约局棋牌平台",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy:server": "wrangler deploy",
    "deploy:web": "vercel deploy --prod"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
